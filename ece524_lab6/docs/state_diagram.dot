digraph Lock {
rankdir=LR;
label="Lab 6 Moore FSM: no key holds state; North resets states 0-9 only; invalid multi-key events ignored";
n0 [label="0: Reset"];
n1 [label="1: S"];
n2 [label="2: SW"];
n3 [label="3: SWE"];
n4 [label="4: Wrong 1"];
n5 [label="5: Wrong 2"];
n6 [label="6: Wrong 2, E"];
n7 [label="7: Wrong 3"];
n8 [label="8: Wrong 3, E"];
n9 [label="9: UNLOCK / U"];
n10 [label="10: ALARM / A"];
n11 [label="11: ALARM / A, recovery W"];
n0 -> n1 [label="S"];
n0 -> n4 [label="E/W"];
n1 -> n2 [label="W"];
n1 -> n5 [label="S"];
n1 -> n6 [label="E"];
n2 -> n3 [label="E"];
n2 -> n7 [label="S/W"];
n3 -> n0 [label="E"];
n3 -> n9 [label="W"];
n3 -> n10 [label="S"];
n4 -> n5 [label="S/W"];
n4 -> n6 [label="E"];
n5 -> n7 [label="S/W"];
n5 -> n8 [label="E"];
n6 -> n0 [label="E"];
n6 -> n7 [label="S/W"];
n7 -> n10 [label="E/S"];
n7 -> n11 [label="W"];
n8 -> n0 [label="E"];
n8 -> n10 [label="S"];
n8 -> n11 [label="W"];
n9 -> n0 [label="E/S/W"];
n10 -> n10 [label="E/S"];
n10 -> n11 [label="W"];
n11 -> n0 [label="E"];
n11 -> n10 [label="S"];
n11 -> n11 [label="W"];
}
